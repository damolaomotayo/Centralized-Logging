    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP status codes (parsed at query time)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
