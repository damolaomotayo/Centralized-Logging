      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (status) (count_over_time({job=\"apps\", service=~\"$service\"} | logfmt | status=~\"[0-9]{3}\" [1m]))",
          "legendFormat": "{{status}}",
          "queryType": "range"
        }
      ],
      "description": "status is NOT a label: logfmt parses it from the line when the query runs.",
