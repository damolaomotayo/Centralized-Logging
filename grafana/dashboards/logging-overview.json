          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"apps\", service=\"alert-receiver\"} | logfmt | event=\"alert_received\" | status=\"firing\" [1h]))",
          "legendFormat": "",
          "queryType": "range"
